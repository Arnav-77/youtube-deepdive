# Copy to .env and fill in. Names only here: never commit real values.
# On Render these are set in the dashboard instead.

# Required. Postgres with pgvector (Neon). Locally, point this at a Neon DEV branch.
DATABASE_URL=postgresql+psycopg://user:password@host.region.aws.neon.tech/dbname?sslmode=require
# Required. Google AI Studio key: Gemini answers (through LiteLLM) and embeddings.
GEMINI_API_KEY=your-google-ai-studio-key

# Optional. Main model; default gemini/gemini-3.6-flash.
GEMINI_MODEL=
# Optional. Backup models tried in order when the main one fails, comma separated,
# e.g. gemini/gemini-3.5-flash-lite
FALLBACK_MODELS=
# Optional. dense (default) or lexical. Any other value stops the app at startup.
RETRIEVAL_METHOD=
# Optional. Admin token: POST /videos needs it, and pastes that send it skip the public limits.
PASTE_TOKEN=
# Optional. Daily cap on chunks stored for visitor pastes (rolling 24 hours); default 600.
PUBLIC_PASTE_DAILY_CHUNKS=
# Optional. Comma-separated video ids to hide from listings and /ask (chunks are kept).
HIDDEN_VIDEO_IDS=
# Set by Render, not by you: the listening port and the deployed commit id.
PORT=
RENDER_GIT_COMMIT=
